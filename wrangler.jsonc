{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflaretempemail",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "pages"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "temp_email_db",
      "database_id": "352aa23f-fe3f-4fa3-93c6-533a7f906818"
    }
  ], 
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "cbf301b8ae5d42538f3653f67173007a"
    }
  ]
}
